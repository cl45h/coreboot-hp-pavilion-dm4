if BOARD_HP_PAVILION_DM4

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select AZALIA_USE_LEGACY_VERB_TABLE
	select BOARD_ROMSIZE_KB_4096
	select EC_ACPI
	select GFX_GMA_PANEL_1_ON_LVDS
	select INTEL_GMA_HAVE_VBT
	select HAVE_ACPI_RESUME
	select HAVE_ACPI_TABLES
	select INTEL_INT15
	select MAINBOARD_HAS_LIBGFXINIT
	select NORTHBRIDGE_INTEL_SANDYBRIDGE
	select SERIRQ_CONTINUOUS_MODE
	select SOUTHBRIDGE_INTEL_BD82X6X
	select SYSTEM_TYPE_LAPTOP
	select USE_NATIVE_RAMINIT

config MAINBOARD_DIR
	string
	default "hp/pavilion_dm4"

config MAINBOARD_PART_NUMBER
	string
	default "Pavilion dm4-3000 series"

config VGA_BIOS_ID
	string
	default "8086,0116"

# Verificado contra el gpio.c leido del hardware: el firmware original
# configura GPIO60 como GPIO_MODE_GPIO + GPIO_DIR_OUTPUT, que es lo que
# southbridge_gate_memory_reset() necesita.
config DRAM_RESET_GATE_GPIO
	int
	default 60

# El indice 2 mapea a 00:1a.0 (EHCI #2), que existe en esta placa.
config USBDEBUG_HCD_INDEX
	int
	default 2
endif
